	mkdir -p "$(dirname "build/output/tmp/$source_file")" || exit $?; \
	g++ -c  -Wall -Wextra -Werror -Wshadow -O2 -D_FORTIFY_SOURCE=2 -fstack-protector-strong -isystem/data/data/com.thawra.termux.ai/files/usr/include -I "lib/termux-core_nos_c/tre/include" -I "lib/termux-core_nos_cxx/tre/include" \
		-DTERMUX_CORE_PKG__VERSION=\"0.4.0\" -DTERMUX__NAME=\"Termux\" -DTERMUX__LNAME=\"termux\" -DTERMUX__REPOS_HOST_ORG_NAME=\"termux\" -DTERMUX_APP__DATA_DIR=\"/data/data/com.thawra.termux.ai\" -DTERMUX__ROOTFS=\"/data/data/com.thawra.termux.ai/files\" -DTERMUX__PREFIX=\"/data/data/com.thawra.termux.ai/files/usr\" -DTERMUX__PREFIX__BIN_DIR=\"/data/data/com.thawra.termux.ai/files/usr/bin\" -DTERMUX__PREFIX__TMP_DIR=\"/data/data/com.thawra.termux.ai/files/usr/tmp\" -DTERMUX_ENV__S_TERMUX=\"TERMUX__\" -DTERMUX_ENV__S_TERMUX_APP=\"TERMUX_APP__\" -DTERMUX_ENV__S_TERMUX_ROOTFS=\"TERMUX_ROOTFS__\" -DTERMUX_ENV__S_TERMUX_CORE__TESTS=\"TERMUX_CORE__TESTS__\" \
		-fPIC -fvisibility=default \
